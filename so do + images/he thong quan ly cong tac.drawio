        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam DefaultFontName Arial\nautonumber\n\n&#39; Khai báo các đối tượng\nactor \&quot;Kế toán\&quot; as KT\nboundary \&quot;Màn hình cấu hình\\n: FrmCauHinhLuat\&quot; as UI\ncontrol \&quot;Xử lý định mức\\n: DinhMucService\&quot; as BUS\ndatabase \&quot;Cơ sở dữ liệu\\n: CSDL_CongTac\&quot; as DB\n\n&#39; Luồng tương tác\nKT -&gt; UI: Nhập thông tin luật (loaiCP, capBac, soTien, tuNgay, denNgay)\nKT -&gt; UI: Bấm \&quot;Thêm quy định\&quot;\nUI -&gt; BUS: themQuyDinh(loaiCP, capBac, soTien, tuNgay, denNgay)\nactivate BUS\n\nBUS -&gt; BUS: kiemTraHopLe(denNgay &gt; tuNgay)\n\nBUS -&gt; DB: kiemTraTrungLapThoiGian(loaiCP, capBac, tuNgay, denNgay)\nactivate DB\nDB --&gt; BUS: traVe(soLuongTrung)\ndeactivate DB\n\nalt soLuongTrung == 0 (Hợp lệ)\n    BUS -&gt; DB: luuQuyDinh(loaiCP, capBac, soTien, tuNgay, denNgay)\n    activate DB\n    DB --&gt; BUS: luuThanhCong(maQuyDinh = \&quot;QD01\&quot;)\n    deactivate DB\n    \n    BUS --&gt; UI: ketQuaXuLy(thanhCong = true)\n    UI --&gt; KT: HienThiThongBao(\&quot;Thêm quy định định mức thành công\&quot;)\nelse soLuongTrung &gt; 0 (Trùng lặp thời gian)\n    BUS --&gt; UI: ketQuaXuLy(thanhCong = false, \&quot;Xung đột thời gian áp dụng\&quot;)\n    UI --&gt; KT: HienThiThongBaoLoi(\&quot;Khoảng thời gian hiệu lực bị trùng lặp\&quot;)\nend\n\ndeactivate BUS\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="s0CCfCZ59_ZjtboH9Y5V-0">
