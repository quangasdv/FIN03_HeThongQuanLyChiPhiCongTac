  <diagram id="o4_aphX73_tKao5XkmiZ" name="class phan tich">
    <mxGraphModel dx="2123" dy="1720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% --- NHÓM 1: DANH MỤC GỐC (MASTER DATA) ---\n    class PhongBan {\n        +String MaPB\n        +String TenPB\n    }\n    class NhanVien {\n        +String MaNV\n        +String HoTen\n        +String ChucVu\n        +String SoTaiKhoan\n    }\n    class LoaiChiPhi {\n        +String MaLoai\n        +String TenLoai\n        +Boolean YeuCauChungTu\n    }\n    class QuyDinhDinhMuc {\n        +String MaQuyDinh\n        +Decimal SoTienToiDa\n        +Date NgayHieuLuc\n    }\n\n    %% --- NHÓM 2 &amp; 3: ĐỀ XUẤT VÀ TẠM ỨNG ---\n    class DeXuatCongTac {\n        +String MaDeXuat\n        +String MucDich\n        +Date NgayDi\n        +Date NgayVe\n        +String TrangThai\n    }\n    class ChiTietDuToan {\n        +String MaChiTiet\n        +Decimal SoTienDuKien\n    }\n    class PhieuTamUng {\n        +String MaTamUng\n        +Date NgayChi\n        +Decimal SoTien\n    }\n\n    %% --- NHÓM 4: KHAI BÁO &amp; CHỨNG TỪ ---\n    class PhieuKhaiBao {\n        +String MaKhaiBao\n        +Date NgayLap\n        +String TrangThai\n    }\n    class ChiTietKhaiBao {\n        +String MaCTKB\n        +Date NgayChi\n        +Decimal SoTienThucTe\n        +String TrangThaiHopLe\n    }\n    class ChungTuOCR {\n        +String MaChungTu\n        +String LinkAnh\n        +String DataBocTach\n    }\n    class GiaiTrinhNgoaiLe {\n        +String MaGiaiTrinh\n        +String LyDo\n        +String KQPheDuyet\n    }\n\n    %% --- NHÓM 5: QUYẾT TOÁN ---\n    class PhieuQuyetToan {\n        +String MaQuyetToan\n        +Date NgayChotSo\n        +Decimal TongTienThuc\n        +Decimal TienBuTru\n    }\n    class GiaoDichThanhToan {\n        +String MaGiaoDich\n        +Date NgayChuyen\n        +Decimal SoTien\n        +String HinhThuc\n    }\n\n    %% ==========================================\n    %% QUAN HỆ &amp; LIÊN KẾT (RELATIONSHIPS)\n    %% ==========================================\n    \n    %% Danh Mục\n    PhongBan \&quot;1\&quot; --&gt; \&quot;0..*\&quot; NhanVien : Thuoc ve\n    LoaiChiPhi \&quot;1\&quot; --&gt; \&quot;0..*\&quot; QuyDinhDinhMuc : Ap dung luat\n    \n    %% Đề xuất công tác\n    NhanVien \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DeXuatCongTac : Lap don\n    DeXuatCongTac \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDuToan : Gom chi tiet\n    LoaiChiPhi \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; ChiTietDuToan : Phan loai\n    \n    %% Tạm ứng\n    DeXuatCongTac \&quot;1\&quot; --&gt; \&quot;0..1\&quot; PhieuTamUng : Duoc tam ung\n    \n    %% Khai báo chi phí\n    DeXuatCongTac \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuKhaiBao : Phat sinh khai bao\n    PhieuKhaiBao \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietKhaiBao : Gom khoan chi\n    LoaiChiPhi \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; ChiTietKhaiBao : Phan loai\n    QuyDinhDinhMuc \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; ChiTietKhaiBao : Check Dinh muc\n    \n    %% Chứng từ và Giải trình (Là thành phần của Chi tiết khai báo)\n    ChiTietKhaiBao \&quot;1\&quot; *-- \&quot;0..1\&quot; ChungTuOCR : Dinh kem anh\n    ChiTietKhaiBao \&quot;1\&quot; *-- \&quot;0..1\&quot; GiaiTrinhNgoaiLe : Kem giai trinh\n    \n    %% Quyết toán\n    DeXuatCongTac \&quot;1\&quot; --&gt; \&quot;0..1\&quot; PhieuQuyetToan : Chot so chuyen di\n    PhieuQuyetToan \&quot;1\&quot; --&gt; \&quot;0..*\&quot; GiaoDichThanhToan : Giao dich bu tru&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="EKwA5B9mgBJGhqJWXzM6-141">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
