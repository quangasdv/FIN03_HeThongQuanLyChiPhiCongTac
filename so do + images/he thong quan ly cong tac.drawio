        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam linetype ortho\nskinparam DefaultFontName Arial\nskinparam TableBackgroundColor white\n\nentity \&quot;PhongBan\&quot; {\n  * MaPB : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * TenPB : nvarchar(100)\n}\n\nentity \&quot;NhanVien\&quot; {\n  * MaNV : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * MaPB : varchar(20) &lt;&lt;FK&gt;&gt;\n  * HoTen : nvarchar(120)\n  * ChucVu : nvarchar(50)\n  SoTaiKhoan : varchar(20)\n}\n\nentity \&quot;LoaiChiPhi\&quot; {\n  * MaLoaiCP : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * TenLoai : nvarchar(100)\n}\n\nentity \&quot;QuyDinhDinhMuc\&quot; {\n  * MaQuyDinh : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * MaLoaiCP : varchar(20) &lt;&lt;FK&gt;&gt;\n  * CapBacApDung : nvarchar(50)\n  * SoTienToiDa : decimal(18,2)\n  * NgayHieuLuc : date\n}\n\nentity \&quot;DeXuatCongTac\&quot; {\n  * MaDeXuat : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * MaNV : varchar(20) &lt;&lt;FK&gt;&gt;\n  * MucDich : nvarchar(250)\n  * NgayDi : date\n  * NgayVe : date\n  * TrangThai : nvarchar(50)\n}\n\nentity \&quot;ChiTietDuToan\&quot; {\n  * MaDeXuat : varchar(30) &lt;&lt;PK, FK&gt;&gt;\n  * MaLoaiCP : varchar(20) &lt;&lt;PK, FK&gt;&gt;\n  --\n  * SoTienDuKien : decimal(18,2)\n}\n\nentity \&quot;PhieuTamUng\&quot; {\n  * MaTamUng : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * MaDeXuat : varchar(30) &lt;&lt;FK&gt;&gt;\n  * MaNVKeToan : varchar(20) &lt;&lt;FK&gt;&gt;\n  * NgayChi : datetime\n  * SoTien : decimal(18,2)\n}\n\nentity \&quot;PhieuKhaiBao\&quot; {\n  * MaKhaiBao : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * MaDeXuat : varchar(30) &lt;&lt;FK&gt;&gt;\n  * NgayLap : datetime\n  * TrangThai : nvarchar(50)\n}\n\nentity \&quot;ChiTietKhaiBao\&quot; {\n  * MaCTKB : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * MaKhaiBao : varchar(30) &lt;&lt;FK&gt;&gt;\n  * MaLoaiCP : varchar(20) &lt;&lt;FK&gt;&gt;\n  * NgayChi : date\n  * SoTienThucTe : decimal(18,2)\n  * TrangThaiHopLe : nvarchar(50)\n}\n\nentity \&quot;ChungTuOCR\&quot; {\n  * MaChungTu : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * MaCTKB : varchar(30) &lt;&lt;FK&gt;&gt;\n  * LinkAnh : nvarchar(255)\n  * DataBocTach : nvarchar(1000)\n}\n\nentity \&quot;GiaiTrinhNgoaiLe\&quot; {\n  * MaGiaiTrinh : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * MaCTKB : varchar(30) &lt;&lt;FK&gt;&gt;\n  * LyDo : nvarchar(250)\n  * KQPheDuyet : nvarchar(50)\n}\n\nentity \&quot;PhieuQuyetToan\&quot; {\n  * MaQuyetToan : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * MaDeXuat : varchar(30) &lt;&lt;FK&gt;&gt;\n  * MaNVKeToan : varchar(20) &lt;&lt;FK&gt;&gt;\n  * NgayChotSo : datetime\n  * TongTienThuc : decimal(18,2)\n  * TienBuTru : decimal(18,2)\n}\n\n&#39; Quan he khoa ngoai (Foreign Keys Relationships)\n&#39; Ky hieu: ||--o{ (1 - Nhieu), ||--o| (1 - 1 hoac 0)\n\nPhongBan ||--o{ NhanVien\nLoaiChiPhi ||--o{ QuyDinhDinhMuc\n\nNhanVien ||--o{ DeXuatCongTac\nDeXuatCongTac ||--o{ ChiTietDuToan\nLoaiChiPhi ||--o{ ChiTietDuToan\n\nDeXuatCongTac ||--o| PhieuTamUng\nNhanVien ||--o{ PhieuTamUng\n\nDeXuatCongTac ||--o{ PhieuKhaiBao\nPhieuKhaiBao ||--|{ ChiTietKhaiBao\nLoaiChiPhi ||--o{ ChiTietKhaiBao\n\nChiTietKhaiBao ||--o| ChungTuOCR\nChiTietKhaiBao ||--o| GiaiTrinhNgoaiLe\n\nDeXuatCongTac ||--o| PhieuQuyetToan\nNhanVien ||--o{ PhieuQuyetToan\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="knz02UohPC2anoguWJC8-556">
